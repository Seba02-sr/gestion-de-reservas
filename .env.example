# Compose profiles
# Examples:
# COMPOSE_PROFILES=frontend,infra,user,reservas,gestion
COMPOSE_PROFILES=frontend,infra,user,reservas,gestion

# Google OAuth Client ID (not secret, but required)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Solo para pruebas manuales de reservas-svc: simula la fecha de hoy (yyyy-MM-dd). Dejar vacío = fecha real
# APP_FECHA_ACTUAL=2027-01-15
