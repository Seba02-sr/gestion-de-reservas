# TODO ES OPCIONAL: `docker compose -f docker/docker-compose.yml up -d --build` funciona sin .env.
# Si querés cambiar algo, copiá este archivo a `.env` (en la raíz o en `docker/`) y descomentá la línea.
# Cada variable tiene un valor por defecto en docker/docker-compose.yml: ${VAR:-valor}.

# Perfiles opcionales (también se pueden pasar con --profile):
#   observability = Collector + Tempo + Loki + Prometheus + Grafana | tools = pgAdmin/phpMyAdmin/Mongo Express
#   dev = frontend con Vite en caliente (http://localhost:5174)
# COMPOSE_PROFILES=observability,tools

# Datos de demo (6 hoteles, habitaciones, tarifas y el usuario demo/demo1234). Por defecto true; false = base vacía.
# DEMO_DATOS_HABILITADO=true

# Login con Google: OPCIONAL. Sin estas variables user-svc arranca igual y el front no muestra el botón.
# VITE_GOOGLE_CLIENT_ID se incrusta al COMPILAR el front: reconstruir con `docker compose build frontend`.
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com

# Frontend: URL de la API. Producción (nginx) = /api (proxy al gateway, mismo origen). Dev (Vite) = el gateway.
# PROD_VITE_API_URL=/api
# VITE_API_URL=http://localhost:8080

# Observabilidad: la exportación OTLP está siempre encendida (sin collector no hace nada); false la apaga.
# OTEL_EXPORT_ENABLED=false
# GRAFANA_ADMIN_PASSWORD=admin

# Solo pruebas: fija "hoy" en reservas-svc (yyyy-MM-dd). Vacío = fecha real.
# APP_FECHA_ACTUAL=2027-01-15

# Con docker/docker-compose.dev-ports.yml (publica las bases en el host): cambiar puertos si están ocupados.
# MYSQL_HOST_PORT=3306
# POSTGRES_HOST_PORT=5432
# MONGO_HOST_PORT=27017
