# Compose profiles
# Examples:
# COMPOSE_PROFILES=frontend,infra,user,reservas,gestion,gateway
COMPOSE_PROFILES=frontend,infra,user,reservas,gestion,gateway

# Login con Google: OPCIONAL. Sin estas variables user-svc arranca igual (POST /users/auth/google responde 503)
# y el frontend no muestra el botón de Google; el login con usuario/contraseña anda siempre.
# Para habilitarlo, descomentar con un Client ID real (con http://localhost:5173 como origen autorizado en Google Cloud).
# GOOGLE_CLIENT_ID=123456789-abc.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}

# Frontend: VITE_* se fijan al COMPILAR (dev: al iniciar Vite; prod: al construir la imagen, `docker compose build`).
# Dev (profile frontend): URL del gateway que usa el navegador.
# VITE_API_URL=http://localhost:8080
# Prod (profile prod, nginx): /api = mismo origen, nginx reenvía al gateway (requiere el profile gateway).
# PROD_VITE_API_URL=/api

# Solo para pruebas manuales de reservas-svc: simula la fecha de hoy (yyyy-MM-dd). Dejar vacío = fecha real
# APP_FECHA_ACTUAL=2027-01-15

# Observabilidad (Etapa 5): agregar `observability` a COMPOSE_PROFILES para levantar
# OpenTelemetry Collector + Tempo + Loki + Prometheus + Grafana (http://localhost:3000, admin/admin).
# COMPOSE_PROFILES=frontend,infra,eureka,user,reservas,gestion,gateway,observability
# Los servicios exportan trazas y logs por OTLP por defecto; con esto en false se apaga la exportación.
# OTEL_EXPORT_ENABLED=false
# GRAFANA_ADMIN_PASSWORD=admin
