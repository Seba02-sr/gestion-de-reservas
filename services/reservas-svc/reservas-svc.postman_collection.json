  "item": [
    {
      "name": "Flujo completo (gestion-svc → reservas-svc)",
      "description": "Ejecutar en orden. Requiere gestion-svc (8083), reservas-svc (8082), RabbitMQ y las bases levantadas (docker compose, COMPOSE_PROFILES=infra,gestion,reservas). Entre un cambio en gestion-svc y su réplica en reservas-svc puede pasar un instante (consistencia eventual): si el paso 5 no encuentra la habitación, esperá 1-2 segundos y reintentá.",
      "item": [
        {
          "name": "1. gestion: crear hotel en Santa Fe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrlGestion}}/hoteles/registrar",
              "host": [
                "{{baseUrlGestion}}"
              ],
              "path": [
                "hoteles",
                "registrar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Hotel Castelar\",\n  \"cuit\": \"30444444440\",\n  \"domicilio\": \"Bv. Pellegrini 2500, Santa Fe\",\n  \"latitud\": -31.6333,\n  \"longitud\": -60.7,\n  \"telefono\": \"342-4555000\",\n  \"correoContacto\": \"contacto@castelar.com\",\n  \"categoria\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Latitud y longitud negativas (Santa Fe)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('hotelId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
