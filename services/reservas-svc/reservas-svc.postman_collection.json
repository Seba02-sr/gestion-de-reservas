  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// fechas por defecto: check-in dentro de 30 días, check-out 5 noches después",
          "const dia = (n) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };",
          "if (!pm.collectionVariables.get('checkIn')) { pm.collectionVariables.set('checkIn', dia(30)); }",
          "if (!pm.collectionVariables.get('checkOut')) { pm.collectionVariables.set('checkOut', dia(35)); }"
        ]
      }
    }
  ],
